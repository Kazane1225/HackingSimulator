{
  "name": "hacklab-simulator",
  "version": "1.0.0",
  "description": "A browser-based, safe-by-design hacking simulator for security training. Vulnerable backends are simulated client-side with 5 escalating security levels per lab.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test:labs": "tsx scripts/test-labs.ts",
    "test:real": "tsx scripts/test-real-labs.ts",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "server:test": "npm --prefix server test",
    "real:up": "docker compose -f docker-compose.real.yml up -d --build",
    "real:down": "docker compose -f docker-compose.real.yml down"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
